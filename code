#!/bin/bash

# Màu sắc giao diện
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
CYAN='\033[1;36m'
NC='\033[0m'

clear
echo -e "${CYAN}================================================${NC}"
echo -e "${GREEN}   UGPHONE AUTO REROLL - API THẬT & CHECK THẬT  ${NC}"
echo -e "${CYAN}================================================${NC}"

# Kiểm tra cài đặt curl và jq
if ! command -v jq &> /dev/null || ! command -v curl &> /dev/null; then
    echo -e "${YELLOW}[*] Đang cài đặt jq và curl...${NC}"
    pkg update -y && pkg install jq curl -y
fi

LOCAL_FILE="local_ug.json"

if [ ! -f "$LOCAL_FILE" ]; then
    echo -e "\n${YELLOW}[*] Chưa tìm thấy dữ liệu local.${NC}"
    echo -e "${CYAN}Hãy dán đoạn JSON local UGPhone của bạn vào bên dưới rồi nhấn Enter:${NC}"
    read -r LOCAL_JSON
    echo "$LOCAL_JSON" > "$LOCAL_FILE"
    echo -e "${GREEN}[+] Đã lưu dữ liệu local thành công!${NC}"
fi

TOKEN=$(jq -r '."UGPHONE-Token"' "$LOCAL_FILE" 2>/dev/null)
LOGIN_ID=$(jq -r '."UGPHONE-MQTT"."login_id"' "$LOCAL_FILE" 2>/dev/null)
[ "$LOGIN_ID" == "null" ] && LOGIN_ID=$(jq -r '."UGPHONE-ID"' "$LOCAL_FILE" 2>/dev/null)

if [ -z "$TOKEN" ] || [ "$TOKEN" == "null" ]; then
    echo -e "${RED}[!] Lỗi: JSON không hợp lệ hoặc thiếu UGPHONE-Token!${NC}"
    rm -f "$LOCAL_FILE"
    exit 1
fi

echo -e "${GREEN}[+] Đã đọc Token thành công từ local!${NC}"
read -p "Nhập Service ID của máy cần đổi (VD: c4dd2bd3-d1b0-cc21-f42f-001ff8d0bf42): " SERVICE_ID
[ -z "$SERVICE_ID" ] && SERVICE_ID="c4dd2bd3-d1b0-cc21-f42f-001ff8d0bf42"

echo -e "\n${CYAN}================================================${NC}"
echo -e "${YELLOW} BẮT ĐẦU VÒNG LẶP REROLL ĐỔI MÁY THẬT...${NC}"
echo -e "${CYAN}================================================${NC}"

ATTEMPT=0

while true; do
    ATTEMPT=$((ATTEMPT + 1))
    echo -e "\n${YELLOW}[🔄 LẦN REROLL THỨ $ATTEMPT]${NC}"
    echo -e " ➔ 1. Gửi API đổi máy (oneKeyNewDevice)..."

    # Gọi API đổi máy
    REPLACE_RES=$(curl -s -X POST "https://www.ugphone.com/api/apiV1/replace_device/oneKeyNewDevice" \
        -H "Access-Token: $TOKEN" \
        -H "Login-Id: $LOGIN_ID" \
        -H "Authorization: Bearer $TOKEN" \
        -H "Content-Type: application/json;charset=UTF-8" \
        -d "{\"service_id\": \"$SERVICE_ID\", \"reason\": \"\", \"replace_reason\": \"3k15c04c-1nhd-z35e-0bsb-98aa9b13d09a\"}")

    echo -e " ➔ Phản hồi đổi máy: $REPLACE_RES"
    
    echo -e " ➔ 2. Chờ 6 giây để server cấp máy mới..."
    sleep 6

    echo -e " ➔ 3. Gọi API lấy danh sách thiết bị (deviceList) để kiểm tra thông số máy mới..."
    
    # Gọi API lấy danh sách thiết bị để kiểm tra thông tin máy sau khi đổi
    LIST_RES=$(curl -s -X POST "https://www.ugphone.com/api/apiV1/device/deviceList" \
        -H "Access-Token: $TOKEN" \
        -H "Login-Id: $LOGIN_ID" \
        -H "Authorization: Bearer $TOKEN" \
        -H "Content-Type: application/json;charset=UTF-8" \
        -d "{\"limit\": 10000}")

    # Lọc thông tin thiết bị tương ứng với service_id của bạn từ danh sách trả về
    DEVICE_INFO=$(echo "$LIST_RES" | jq --arg sid "$SERVICE_ID" '.data.list[]? | select(.service_id == $sid)')

    if [ -z "$DEVICE_INFO" ] || [ "$DEVICE_INFO" == "null" ]; then
        echo -e "${RED}[!] Không tìm thấy thông tin thiết bị, thử lại...${NC}"
        continue
    fi

    # Lấy tên hoặc thông số phần cứng/chip của máy mới từ JSON trả về
    DEVICE_NAME=$(echo "$DEVICE_INFO" | jq -r '.device_name // .name // "Unknown"')
    HARDWARE_INFO=$(echo "$DEVICE_INFO" | jq -r '.hardware // .chip // .model // "Standard"')

    echo -e " ➔ Tên thiết bị hiện tại: ${CYAN}$DEVICE_NAME${NC}"
    echo -e " ➔ Thông số phần cứng/Chip: ${CYAN}$HARDWARE_INFO${NC}"

    # Điều kiện dừng: Bạn có thể thay đổi từ khóa kiểm tra (ví dụ chứa từ 'VIP', 'High', hoặc tên chip mong muốn)
    if echo "$HARDWARE_INFO" | grep -qiE "VIP|High|Snapdragon|Performance"; then
        echo -e "\n${GREEN}================================================${NC}"
        echo -e "${GREEN}  🎉 SĂN ĐƯỢC MÁY CẤU HÌNH NGON SAU $ATTEMPT LẦN! 🎉 ${NC}"
        echo -e "${GREEN}================================================${NC}"
        echo "SERVICE_ID=\"$SERVICE_ID\"" > config_device.txt
        echo "ATTEMPTS=\"$ATTEMPT\"" >> config_device.txt
        break
    else
        echo -e "${RED}[!] Máy chưa đạt cấu hình mong muốn, tiếp tục đổi...${NC}"
        sleep 3
    fi
done
