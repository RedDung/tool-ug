import json
import getpass
import sys
import time
import os

# =====================================
#       UGPHONE AUTO REROLL V2
# =====================================

GREEN = "\033[1;32m"
RED = "\033[1;31m"
CYAN = "\033[1;36m"
YELLOW = "\033[1;33m"
RESET = "\033[0m"


def banner():
    os.system("clear")
    print(CYAN + """
╔══════════════════════════════════════╗
║        UGPHONE AUTO REROLL V2        ║
║             TERMUX EDITION           ║
╚══════════════════════════════════════╝
""" + RESET)


def input_local():
    print(YELLOW + "[+] Dán Local UGPhone.")
    print("[+] Nhấn Enter hai lần để kết thúc." + RESET)

    lines = []

    while True:
        try:
            line = getpass.getpass("")
        except EOFError:
            break

        if not line:
            break

        lines.append(line)

    raw = "\n".join(lines)

    try:
        data = json.loads(raw)
        return data
    except json.JSONDecodeError:
        print(RED + "[!] Local JSON không hợp lệ!" + RESET)
        return None


def check_local(data):
    required = [
        "UGPHONE-ID",
        "UGPHONE-Token",
        "UGPHONE-MQTT"
    ]

    for key in required:
        if key not in data:
            print(RED + f"[!] Thiếu trường: {key}" + RESET)
            return False

    print(GREEN + "[+] Đã nhận diện cấu trúc Local." + RESET)
    return True


def main():
    banner()

    print("[1] Nhập Local UGPhone")
    print("[2] Thoát")

    choice = input("\nLựa chọn: ")

    if choice == "2":
        sys.exit()

    if choice != "1":
        return

    data = input_local()

    if data is None:
        return

    if not check_local(data):
        return

    print(CYAN + "\n========== LOCAL INFO ==========")
    print("UGPHONE ID:", data.get("UGPHONE-ID"))
    print("Language:", data.get("ugPhoneLang", "Unknown"))
    print("MQTT:", "Available" if data.get("UGPHONE-MQTT") else "Unavailable")
    print("================================" + RESET)

    print(YELLOW + """
[!] Local đã được kiểm tra cấu trúc.

[!] Chưa kết nối UGPhone.
[!] Chưa thực hiện thay thế thiết bị.

Cần tích hợp giao thức Device Replace
và Device Hardware Info chính thức.
""" + RESET)

    data.clear()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nĐã dừng chương trình.")
