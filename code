import json
import sys
import os

GREEN = "\033[1;32m"
RED = "\033[1;31m"
CYAN = "\033[1;36m"
YELLOW = "\033[1;33m"
RESET = "\033[0m"


def banner():
    os.system("clear")
    print(CYAN + """
╔══════════════════════════════════════╗
║        UGPHONE AUTO REROLL V2        ║
║             TERMUX EDITION           ║
╚══════════════════════════════════════╝
""" + RESET)


def input_local():
    while True:
        print(YELLOW + "\n[+] Dán Local UGPhone.")
        print("[+] Nhấn Enter hai lần để kết thúc." + RESET)

        lines = []

        while True:
            try:
                line = input()
            except EOFError:
                return None

            if line == "":
                if lines:
                    break
                print(RED + "[!] Chưa nhập Local!" + RESET)
                continue

            lines.append(line)

        raw = "\n".join(lines)

        try:
            data = json.loads(raw)

            if not isinstance(data, dict):
                raise ValueError("JSON phải là object")

            if check_local(data):
                return data

        except (json.JSONDecodeError, ValueError) as e:
            print(RED + f"\n[!] Local không hợp lệ: {e}" + RESET)
            print(YELLOW + "[+] Hãy dán lại Local!" + RESET)


def check_local(data):
    required = [
        "UGPHONE-ID",
        "UGPHONE-Token",
        "UGPHONE-MQTT"
    ]

    missing = [key for key in required if key not in data]

    if missing:
        print(RED + "\n[!] Local thiếu trường:" + RESET)

        for key in missing:
            print(RED + " - " + key + RESET)

        return False

    if not isinstance(data["UGPHONE-MQTT"], dict):
        print(RED + "[!] Cấu trúc MQTT không hợp lệ!" + RESET)
        return False

    print(GREEN + "\n[+] Đã nhận diện cấu trúc Local!" + RESET)
    return True


def main():
    while True:
        banner()

        print("[1] Nhập Local UGPhone")
        print("[2] Thoát")

        choice = input("\nLựa chọn: ").strip()

        if choice == "2":
            print(YELLOW + "Đã thoát." + RESET)
            break

        if choice != "1":
            print(RED + "[!] Lựa chọn không hợp lệ!" + RESET)
            input("Nhấn Enter để tiếp tục...")
            continue

        data = input_local()

        if data is None:
            break

        print(CYAN + "\n========== LOCAL INFO ==========")
        print("UGPHONE ID:", data.get("UGPHONE-ID"))
        print("Language:", data.get("ugPhoneLang", "Unknown"))
        print("MQTT:", "Available")
        print("================================" + RESET)

        print(YELLOW + """
[!] Đã kiểm tra cấu trúc Local.
[!] Chưa kết nối UGPhone.
[!] Chưa thực hiện thay thế thiết bị.
""" + RESET)

        data.clear()

        input("\nNhấn Enter để quay lại menu...")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        print("\nĐã dừng chương trình.")
