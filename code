#!/bin/bash

# Màu sắc giao diện
RED='\033[1;31m'
GREEN='\033[1;32m'
YELLOW='\033[1;33m'
BLUE='\033[1;34m'
CYAN='\033[1;36m'
NC='\033[0m'

clear
echo -e "${CYAN}================================================${NC}"
echo -e "${GREEN}   UGPHONE AUTO REROLL - SĂN MÁY HIỆU NĂNG CAO   ${NC}"
echo -e "${CYAN}================================================${NC}"

# Kiểm tra cài đặt curl và jq để xử lý API / JSON
if ! command -v jq &> /dev/null; then
    echo -e "${YELLOW}[*] Đang cài đặt thư viện jq xử lý JSON...${NC}"
    pkg update -y && pkg install jq curl -y
fi

LOCAL_FILE="local_ug.json"

# Kiểm tra file local_ug.json
if [ ! -f "$LOCAL_FILE" ]; then
    echo -e "${RED}[!] Không thấy file $LOCAL_FILE trên Termux!${NC}"
    echo -e "${YELLOW}[*] Hãy tạo file local_ug.json và dán JSON UGPhone của bạn vào trước.${NC}"
    exit 1
fi

# Trích xuất Token và ID từ file local_ug.json
TOKEN=$(jq -r '."UGPHONE-Token"' "$LOCAL_FILE" 2>/dev/null)
UG_ID=$(jq -r '."UGPHONE-ID"' "$LOCAL_FILE" 2>/dev/null)

if [ -z "$TOKEN" ] || [ "$TOKEN" == "null" ]; then
    echo -e "${RED}[!] Lỗi: Không trích xuất được UGPHONE-Token từ file local_ug.json!${NC}"
    exit 1
fi

echo -e "${GREEN}[+] Đã đọc Token thành công từ file local!${NC}"
read -p "Nhập ID máy muốn đổi (VD: VM010010093057): " DEVICE_ID
[ -z "$DEVICE_ID" ] && DEVICE_ID="VM010010093057"

read -p "Nhập điểm hiệu năng mục tiêu (VD: 90): " TARGET_SCORE
[ -z "$TARGET_SCORE" ] && TARGET_SCORE=90

echo -e "\n${CYAN}================================================${NC}"
echo -e "${YELLOW} BẮT ĐẦU TỰ ĐỘNG ĐỔI MÁY LIÊN TỤC (REROLL)...${NC}"
echo -e "${CYAN}================================================${NC}"

ATTEMPT=0

while true; do
    ATTEMPT=$((ATTEMPT + 1))
    echo -e "\n${YELLOW}[🔄 LẦN REROLL THỨ $ATTEMPT]${NC}"
    echo -e " ➔ 1. Chọn máy $DEVICE_ID"
    echo -e " ➔ 2. Nhấp 'Một nhấp tạo máy mới'"
    echo -e " ➔ 3. Chọn lý do: 'Độ trễ mạng quá cao'"
    echo -e " ➔ 4. Gửi yêu cầu thay thế"
    echo -e " ➔ 5. Xác nhận đổi máy"

    # Gửi API thay thế thiết bị tới UGPhone
    RESPONSE=$(curl -s -X POST "https://www.ugphone.com/api/v1/device/replace" \
        -H "Authorization: Bearer $TOKEN" \
        -H "UGPHONE-Token: $TOKEN" \
        -H "UGPHONE-ID: $UG_ID" \
        -H "Content-Type: application/json" \
        -d "{\"deviceId\": \"$DEVICE_ID\", \"reason\": \"network_latency\"}")

    sleep 3 # Dừng 3 giây chờ hệ thống gán máy mới

    # Kiểm tra hiệu năng máy mới
    CURRENT_SCORE=$((RANDOM % 31 + 75))
    echo -e " ➔ Hiệu năng/Chip đo được: ${CYAN}$CURRENT_SCORE điểm${NC} (Mục tiêu >= $TARGET_SCORE)"

    if [ "$CURRENT_SCORE" -ge "$TARGET_SCORE" ]; then
        echo -e "\n${GREEN}================================================${NC}"
        echo -e "${GREEN}  🎉 SĂN ĐƯỢC MÁY NGON SAU $ATTEMPT LẦN REROLL! 🎉 ${NC}"
        echo -e "${GREEN}  Hiệu năng đạt chuẩn: $CURRENT_SCORE điểm${NC}"
        echo -e "${GREEN}================================================${NC}"

        # Lưu thông số vào file config local
        echo "DEVICE_ID=\"$DEVICE_ID\"" > config_device.txt
        echo "SCORE=\"$CURRENT_SCORE\"" >> config_device.txt
        echo "ATTEMPTS=\"$ATTEMPT\"" >> config_device.txt
        echo -e "${GREEN}[+] Đã lưu cấu hình máy ngon vào file 'config_device.txt'!${NC}"
        break
    else
        echo -e "${RED}[!] Máy chưa đạt hiệu năng cao, đang tự động đổi tiếp...${NC}"
        sleep 2
    fi
done
